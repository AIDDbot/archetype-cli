{
  "name": "cli",
  "displayName": "Archetype CLI",
  "version": "0.4.14",
  "private": true,
  "description": "A local command-line application and its acceptance suite",
  "homepage": "https://aiddbot.com",
  "license": "MIT",
  "author": {
    "name": "Alberto Basalo",
    "url": "https://x.com/albertobasalo"
  },
  "bin": {
    "archetype-cli": "src/app.main.ts"
  },
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*",
    "#core/*": "./src/core/*",
    "#api/*": "./src/features/*/*.api.ts",
    "#package": "./package.json"
  },
  "scripts": {
    "start": "node src/app.main.ts",
    "test": "vp test run",
    "layers": "vp lint -c boundaries.json",
    "crap": "vp lint -c complexity.json && vp test run --coverage"
  }
}
