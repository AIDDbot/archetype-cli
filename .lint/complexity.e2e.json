{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "eslint/complexity": [
      "error",
      {
        "max": 8
      }
    ],
    "eslint/max-statements": [
      "error",
      {
        "max": 64
      }
    ],
    "eslint/max-depth": [
      "error",
      {
        "max": 4
      }
    ],
    "eslint/max-params": [
      "error",
      {
        "max": 4
      }
    ],
    "eslint/max-lines": [
      "error",
      {
        "max": 256,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  }
}
