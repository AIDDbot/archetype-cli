{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["import"],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "import/no-relative-parent-imports": "error",
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/src/**"],
            "message": "The e2e is a black box: it starts each project with its start command and never imports its code."
          }
        ]
      }
    ]
  }
}
