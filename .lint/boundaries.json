{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["import"],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "import/no-relative-parent-imports": "error"
  },
  "overrides": [
    {
      "files": ["**/src/app.*.{ts,tsx}"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["./features/**", "!./features/features.manifest.{ts,tsx}", "#api/**"],
                "message": "main uses the features only through the manifest."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/{core,shared}/**/*.{ts,tsx}"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["#api/**"],
                "message": "core and shared never use a feature. The composition connects them."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/features/features.manifest.{ts,tsx}"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["./*/*.{api,service,policy,store,repository,client}.{ts,tsx}", "#api/**"],
                "message": "The manifest uses only the presentation (the registration) of each feature."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/features/*/*.{controller,request,command,page,component,card}.{ts,tsx}"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["./*.{repository,client}.{ts,tsx}"],
                "message": "presentation never uses data: only the registration (routes) creates it for logic. The direction is presentation → logic → data."
              }
            ],
            "paths": [
              {
                "name": "react",
                "importNames": ["useEffect", "useLayoutEffect", "useMemo", "useCallback", "memo"],
                "message": "A page gets its data from the loader of its route and changes it with its action: no effect to fetch data, and no manual memoization."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/features/*/*.api.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "./*.{routes,controller,request,command,page,component,card,repository,client}.{ts,tsx}"
                ],
                "message": "The facade never uses presentation or data. The direction is facade → logic → data."
              }
            ],
            "paths": [
              {
                "name": "react",
                "message": "Only a .tsx file of presentation, core or shared uses React: facades, logic and data are plain TypeScript, which unit tests prove."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/features/*/*.{service,policy,store}.{ts,tsx}"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "./*.{routes,controller,request,command,page,component,card}.{ts,tsx}",
                  "./*.api.ts"
                ],
                "message": "logic never uses presentation or the facade. The direction is presentation → logic → data."
              }
            ],
            "paths": [
              {
                "name": "react",
                "message": "Only a .tsx file of presentation, core or shared uses React: facades, logic and data are plain TypeScript, which unit tests prove."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/features/*/*.{repository,client}.{ts,tsx}"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "./*.{routes,controller,request,command,page,component,card,service,policy,store}.{ts,tsx}",
                  "./*.api.ts"
                ],
                "message": "data never uses presentation, logic or the facade. The direction is presentation → logic → data."
              }
            ],
            "paths": [
              {
                "name": "react",
                "message": "Only a .tsx file of presentation, core or shared uses React: facades, logic and data are plain TypeScript, which unit tests prove."
              }
            ]
          }
        ]
      }
    }
  ]
}
